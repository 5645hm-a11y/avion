<Project Sdk="Microsoft.NET.Sdk">
  <!-- A .NET 8 WinForms player on avion.dll (API 12 embedding). avion.dll is taken from the build (or the bundle's bin\),
       copied next to the program. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvionDll Condition="'$(AvionDll)' == '' and Exists('..\..\..\build\Release\avion.dll')">..\..\..\build\Release\avion.dll</AvionDll>
    <AvionDll Condition="'$(AvionDll)' == '' and Exists('..\..\..\bin\avion.dll')">..\..\..\bin\avion.dll</AvionDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(AvionDll)' != ''">
    <None Include="$(AvionDll)" Link="avion.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
